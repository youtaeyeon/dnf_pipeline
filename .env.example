# 로컬에서 스크립트를 직접 실행할 때만 사용합니다.
# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 Git에 올리지 않습니다)
# Airflow에서 실행할 때는 Connection(mysql_conn)과 Variable(NEOPLE_API_KEY)로 주입됩니다.

# --- Neople Open API ---
NEOPLE_API_KEY=

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bronze

# --- 수집 옵션 ---
TABLE_NAME=timeline_ranker
RANKER_TABLE=ranker_info
CHUNK_SIZE=100
# 0이면 랭커 전체
TOP_N=0
# 예: 2025-12-11 06:00:00 (Airflow 실행 시에는 자동 계산)
START_DATE=
END_DATE=
